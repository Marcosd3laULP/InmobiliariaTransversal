<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/tvDetalleDireccion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="117dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="116dp"
        android:text="Direccion"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="@+id/imageView2"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/tvDetalleUso"
        app:layout_constraintTop_toBottomOf="@+id/imageView2" />

    <TextView
        android:id="@+id/tvDetalleValor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:text="Valor"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="@+id/tvDetalleDireccion"
        app:layout_constraintTop_toBottomOf="@+id/tvDetalleDireccion" />

    <TextView
        android:id="@+id/tvDetalleUso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:layout_marginTop="74dp"
        android:text="Uso"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView2" />

    <TextView
        android:id="@+id/tvDetalleTipo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:layout_marginTop="21dp"
        android:text="Tipo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvDetalleUso" />

    <TextView
        android:id="@+id/tvDetallesAmbientes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:layout_marginTop="26dp"
        android:text="Ambientes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvDetalleTipo" />

    <TextView
        android:id="@+id/tvDetalleSuperficie"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Superficie"
        app:layout_constraintStart_toEndOf="@+id/tvDetalleValor"
        app:layout_constraintTop_toBottomOf="@+id/tvDetalleValor" />

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="305dp"
        android:layout_height="164dp"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.415"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:srcCompat="@tools:sample/avatars" />

    <TextView
        android:id="@+id/tvDetalleLatitud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="22dp"
        android:text="Latitud"
        app:layout_constraintBottom_toTopOf="@+id/tvDetalleLongitud"
        app:layout_constraintStart_toStartOf="@+id/tvDetalleLongitud" />

    <TextView
        android:id="@+id/tvDetalleLongitud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="73dp"
        android:text="Longitud"
        app:layout_constraintStart_toStartOf="@+id/tvDetalleSuperficie"
        app:layout_constraintTop_toBottomOf="@+id/tvDetalleSuperficie" />

    <CheckBox
        android:id="@+id/cbDisponibilidad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="55dp"
        android:layout_marginTop="86dp"
        android:layout_marginEnd="55dp"
        android:text="Disponible"
        app:layout_constraintEnd_toEndOf="@+id/tvDetalleLatitud"
        app:layout_constraintStart_toStartOf="@+id/imageView2"
        app:layout_constraintTop_toBottomOf="@+id/tvDetalleLongitud" />
</androidx.constraintlayout.widget.ConstraintLayout>