<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/frameLayout3"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".contrato.ContratoFragmentDetalle">

    <TextView
        android:id="@+id/tvContratoTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="38dp"
        android:text="Informacion del contrato"
        android:textSize="24sp"
        app:layout_constraintBottom_toTopOf="@+id/tvCodigoContrato"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvCodigoContrato"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="135dp"
        android:text="Codigo contrato"
        android:textSize="20sp"
        app:layout_constraintEnd_toStartOf="@+id/tvContratoTitulo"
        app:layout_constraintStart_toStartOf="@+id/tvContratoTitulo"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvContratoFechaInicio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="29dp"
        android:text="Fecha de Inicio"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="@+id/tvCodigoCampoContrato"
        app:layout_constraintStart_toEndOf="@+id/tvCodigoCampoContrato"
        app:layout_constraintTop_toBottomOf="@+id/tvCodigoCampoContrato" />

    <TextView
        android:id="@+id/tvContratoFechaFin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="1dp"
        android:layout_marginTop="23dp"
        android:text="Fecha de finalizacion"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvFechaInicioCampo" />

    <TextView
        android:id="@+id/tvMontoAlquiler"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:text="Monto alquiler"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="@+id/tvInmuebleCampoContrato"
        app:layout_constraintStart_toEndOf="@+id/tvInmuebleCampoContrato"
        app:layout_constraintTop_toBottomOf="@+id/tvInmuebleCampoContrato" />

    <TextView
        android:id="@+id/tvContratoInquilino"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="1dp"
        android:layout_marginTop="40dp"
        android:text="Inquilino"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvFechaFinCampo" />

    <TextView
        android:id="@+id/tvContratoInmueble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="1dp"
        android:layout_marginTop="36dp"
        android:text="Inmueble"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvMontoCampo" />

    <Button
        android:id="@+id/btPagosContrato"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="38dp"
        android:layout_marginBottom="273dp"
        android:text="Pagos"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvCodigoCampoContrato"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:layout_marginTop="1dp"
        android:text="TextView"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="@+id/tvCodigoContrato"
        app:layout_constraintTop_toBottomOf="@+id/tvCodigoContrato" />

    <TextView
        android:id="@+id/tvFechaInicioCampo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="1dp"
        android:layout_marginTop="12dp"
        android:text="TextView"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvContratoFechaInicio" />

    <TextView
        android:id="@+id/tvFechaFinCampo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TextView"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="@+id/tvMontoAlquiler"
        app:layout_constraintTop_toBottomOf="@+id/tvMontoAlquiler" />

    <TextView
        android:id="@+id/tvMontoCampo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TextView"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="@+id/tvContratoInquilino"
        app:layout_constraintTop_toBottomOf="@+id/tvContratoInquilino" />

    <TextView
        android:id="@+id/tvInquilinoCampoContrato"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TextView"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="@+id/tvContratoInmueble"
        app:layout_constraintTop_toBottomOf="@+id/tvContratoInmueble" />

    <TextView
        android:id="@+id/tvInmuebleCampoContrato"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TextView"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="@+id/tvContratoFechaFin"
        app:layout_constraintTop_toBottomOf="@+id/tvContratoFechaFin" />
</androidx.constraintlayout.widget.ConstraintLayout>