<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/nav_inicio">


    <fragment
        android:id="@+id/nav_inicio"
        android:name="com.basico91.inmobiliariatransversal.menu.InicioFragment"
        android:label="@string/menu_inicio"
        tools:layout="@layout/fragment_inicio" >
    </fragment>


    <fragment
        android:id="@+id/nav_perfil"
        android:name="com.basico91.inmobiliariatransversal.perfil.PerfilFragment"
        android:label="@string/menu_perfil"
        tools:layout="@layout/fragment_perfil" >
        <action
            android:id="@+id/action_nav_perfil_to_editarPerfilFragment"
            app:destination="@id/editarPerfilFragment" />
        <action
            android:id="@+id/action_nav_perfil_to_cambiarPassFragment"
            app:destination="@id/cambiarPassFragment" />
    </fragment>

    <fragment
        android:id="@+id/nav_inmueble"
        android:name="com.basico91.inmobiliariatransversal.inmueble.InmuebleFragment"
        android:label="Inmueble"
        tools:layout="@layout/fragment_inmueble" >
        <action
            android:id="@+id/action_nav_inmueble_to_detalleInmuebleFragment"
            app:destination="@id/detalleInmuebleFragment" />
        <action
            android:id="@+id/action_nav_inmueble_to_cargarInmuebleFragment"
            app:destination="@id/cargarInmuebleFragment" />
    </fragment>

    <fragment
        android:id="@+id/nav_inquilino"
        android:name="com.basico91.inmobiliariatransversal.inquilino.InquilinoFragment"
        android:label="Inquilino"
        tools:layout="@layout/fragment_inquilino" >
        <action
            android:id="@+id/action_nav_inquilino_to_inquilinoFragmentDetalle"
            app:destination="@id/inquilinoFragmentDetalle" />
    </fragment>

    <fragment
        android:id="@+id/nav_contrato"
        android:name="com.basico91.inmobiliariatransversal.contrato.ContratoFragment"
        android:label="Contrato"
        tools:layout="@layout/fragment_contrato" >
        <action
            android:id="@+id/action_nav_contrato_to_contratoFragmentDetalle"
            app:destination="@id/contratoFragmentDetalle" />
    </fragment>

    <fragment
        android:id="@+id/nav_logOut"
        android:name="com.basico91.inmobiliariatransversal.LogOutFragment"
        android:label="Salir"
        tools:layout="@layout/fragment_log_out" />
    <fragment
        android:id="@+id/editarPerfilFragment"
        android:name="com.basico91.inmobiliariatransversal.perfil.EditarPerfilFragment"
        android:label="fragment_editar_perfil"
        tools:layout="@layout/fragment_editar_perfil" >
        <action
            android:id="@+id/action_editarPerfilFragment_to_nav_perfil"
            app:destination="@id/nav_perfil" />
    </fragment>
    <fragment
        android:id="@+id/cambiarPassFragment"
        android:name="com.basico91.inmobiliariatransversal.perfil.CambiarPassFragment"
        android:label="fragment_cambiar_pass"
        tools:layout="@layout/fragment_cambiar_pass" >
        <action
            android:id="@+id/action_cambiarPassFragment_to_nav_perfil"
            app:destination="@id/nav_perfil" />
    </fragment>
    <fragment
        android:id="@+id/detalleInmuebleFragment"
        android:name="com.basico91.inmobiliariatransversal.inmueble.DetalleInmuebleFragment"
        android:label="DetalleInmuebleFragment" >
        <action
            android:id="@+id/action_detalleInmuebleFragment_to_nav_inmueble"
            app:destination="@id/nav_inmueble" />
    </fragment>
    <fragment
        android:id="@+id/cargarInmuebleFragment"
        android:name="com.basico91.inmobiliariatransversal.inmueble.CargarInmuebleFragment"
        android:label="CargarInmuebleFragment" >
        <action
            android:id="@+id/action_cargarInmuebleFragment_to_nav_inmueble"
            app:destination="@id/nav_inmueble" />
    </fragment>
    <fragment
        android:id="@+id/contratoFragmentDetalle"
        android:name="com.basico91.inmobiliariatransversal.contrato.ContratoFragmentDetalle"
        android:label="Detalle"
        tools:layout="@layout/fragment_contrato_detalle">
        <action
            android:id="@+id/action_contratoFragmentDetalle_to_pagoFragment"
            app:destination="@id/pagoFragment" />
        <action
            android:id="@+id/action_contratoFragmentDetalle_to_nav_contrato"
            app:destination="@id/nav_contrato" />
    </fragment>
    <fragment
        android:id="@+id/pagoFragment"
        android:name="com.basico91.inmobiliariatransversal.contrato.PagoFragment"
        android:label="fragment_pago"
        tools:layout="@layout/fragment_pago" >
        <action
            android:id="@+id/action_pagoFragment_to_contratoFragmentDetalle"
            app:destination="@id/contratoFragmentDetalle" />
    </fragment>
    <fragment
        android:id="@+id/inquilinoFragmentDetalle"
        android:name="com.basico91.inmobiliariatransversal.inquilino.InquilinoFragmentDetalle"
        android:label="Detalle"
        tools:layout="@layout/fragment_inquilino_detalle">
        <action
            android:id="@+id/action_inquilinoFragmentDetalle_to_nav_inquilino"
            app:destination="@id/nav_inquilino" />
    </fragment>
</navigation>